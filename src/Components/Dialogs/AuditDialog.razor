<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Audit Log — @Label</MudText></TitleContent>
    <DialogContent>
        <DialogHotkeys OnCancel="() => MudDialog.Cancel()" />
        @if (_events.Count == 0)
        {
            <MudText Typo="Typo.body2">No audit events for this item.</MudText>
        }
        else
        {
            <MudTable Items="_events" Dense="true" Hover="true" Style="max-height:400px;overflow-y:auto">
                <HeaderContent>
                    <MudTh>When (UTC)</MudTh>
                    <MudTh>Who</MudTh>
                    <MudTh>Action</MudTh>
                    <MudTh>Field</MudTh>
                    <MudTh>Old</MudTh>
                    <MudTh>New</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="When">@context.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</MudTd>
                    <MudTd DataLabel="Who">@context.Actor</MudTd>
                    <MudTd DataLabel="Action">@context.Action</MudTd>
                    <MudTd DataLabel="Field">@context.FieldName</MudTd>
                    <MudTd DataLabel="Old"><span class="audit-val">@context.OldValue</span></MudTd>
                    <MudTd DataLabel="New"><span class="audit-val">@context.NewValue</span></MudTd>
                </RowTemplate>
            </MudTable>
        }
    </DialogContent>
    <DialogActions><MudButton OnClick="() => MudDialog.Close()">Close</MudButton></DialogActions>
</MudDialog>


