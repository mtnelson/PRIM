<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="@(Result.FailCount == 0 ? Severity.Success : Severity.Warning)" Class="mb-3">
            @Result.SuccessCount of @(Result.SuccessCount + Result.FailCount) barcode(s) processed successfully.
            @if (Result.FailCount > 0)
            {
                <span>Failed barcodes were kept in the scan field — fix and re-run, or correct them elsewhere.</span>
            }
        </MudAlert>
        @if (_failures.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-1"><b>Failed</b></MudText>
            <MudList T="string" Dense="true">
                @foreach (var f in _failures)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.ErrorOutline" IconColor="Color.Error">
                        <MudText Typo="Typo.body2"><b>@f.Barcode</b> — @f.Message</MudText>
                    </MudListItem>
                }
            </MudList>
        }
        @if (_successes.Count > 0 && _failures.Count > 0)
        {
            <MudExpansionPanels Class="mt-2">
                <MudExpansionPanel Text="@($"Succeeded ({_successes.Count})")">
                    <MudList T="string" Dense="true">
                        @foreach (var s in _successes)
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircleOutline" IconColor="Color.Success">
                                <MudText Typo="Typo.body2"><b>@s.Barcode</b> — @s.Message</MudText>
                            </MudListItem>
                        }
                    </MudList>
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="() => MudDialog.Close()">OK</MudButton>
    </DialogActions>
</MudDialog>
