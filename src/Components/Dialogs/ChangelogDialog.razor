@* Renders wwwroot/changelog.md with a minimal markdown subset (# / ## / - / text). *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">PRIM Changelog</MudText>
    </TitleContent>
    <DialogContent>
        @foreach (var b in _blocks)
        {
            @switch (b.Kind)
            {
                case "h1":
                    <MudText Typo="Typo.h5" Class="mb-2">@b.Text</MudText>
                    break;
                case "h2":
                    <MudText Typo="Typo.subtitle1" Class="mt-3 mb-1"><b>@b.Text</b></MudText>
                    break;
                case "ul":
                    <ul class="mb-2" style="padding-left:1.2rem">
                        @foreach (var item in b.Items ?? Enumerable.Empty<string>())
                        {
                            <li><MudText Typo="Typo.body2" Inline="true">@item</MudText></li>
                        }
                    </ul>
                    break;
                default:
                    if (!string.IsNullOrWhiteSpace(b.Text))
                    {
                        <MudText Typo="Typo.body2" Class="mb-1">@b.Text</MudText>
                    }
                    break;
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Close()">Close</MudButton>
    </DialogActions>
</MudDialog>


