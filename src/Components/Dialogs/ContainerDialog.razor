<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_model.Id == 0 ? "New Container" : $"Edit Container {_model.ContainerName}")</MudText>
    </TitleContent>
    <DialogContent>
        <DialogHotkeys OnSave="Save" OnCancel="() => MudDialog.Cancel()" />
        <MudForm @ref="_form" Model="_model">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Container Type *" @bind-Value="_model.ContainerType" Required="true">
                        @foreach (var t in SeedData.ContainerTypes) { <MudSelectItem Value="t">@t</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Field Office *" @bind-Value="_model.FieldOffice" Required="true">
                        @foreach (var fo in SeedData.FieldOffices) { <MudSelectItem Value="@fo.Code">@($"{fo.Code} - {fo.Name}")</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Container Code *" @bind-Value="_model.ContainerCode" Required="true">
                        @foreach (var c in new[] { "SHIP", "NARA", "RESH", "9999", "PENT" }) { <MudSelectItem Value="c">@c</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Formatted Number *" @bind-Value="_model.FormattedNumber" Required="true"
                                  HelperText="Defaults to next available; you may change it." />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Container Name *" @bind-Value="_model.ContainerName" Required="true"
                                  ReadOnly="_model.Id != 0" HelperText="System-generated per naming rules; unique per type." />
                    @if (_model.Id == 0)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mt-1" OnClick="GenerateName">Generate name</MudButton>
                    }
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Description" @bind-Value="_model.Description" Lines="2" HelperText="Initial case." />
                </MudItem>
                <MudItem xs="12" md="6">
                    <LabelPicker @bind-Selected="_labels" Actor="@App.CurrentUserId" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Home *" @bind-Value="_model.Home" Required="true" ReadOnly="true"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="PickHome" />
                    <MudText Typo="Typo.caption">@_model.HomeKind</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Assignee *" Value="_model.Assignee" Required="true" ReadOnly="true"
                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="PickAssignee" />
                    <MudText Typo="Typo.caption">@_model.AssigneeKind</MudText>
                </MudItem>
            </MudGrid>
            @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>


