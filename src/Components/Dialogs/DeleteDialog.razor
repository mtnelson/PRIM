<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Delete @Ids.Count record(s)</MudText></TitleContent>
    <DialogContent>
        <DialogHotkeys OnSave="Submit" OnCancel="() => MudDialog.Cancel()" />
        <MudText Typo="Typo.body2" Class="mb-3">
            Deleted records are immediately excluded from search and moved to a deletion state.
            A reason is required.
        </MudText>
        <MudRadioGroup T="string" @bind-Value="_reason">
            <MudRadio Value="@("Duplicate entry")">Duplicate entry</MudRadio>
            <MudRadio Value="@("Merged with case file")">Merged with case file</MudRadio>
            <MudRadio Value="@("Invalid Case Number")">Invalid Case Number</MudRadio>
            <MudRadio Value="@("All files within range dispositioned")">All files within range dispositioned</MudRadio>
            <MudRadio Value="@("Other")">Other</MudRadio>
        </MudRadioGroup>
        @if (_reason == "Merged with case file")
        {
            <MudTextField T="string" Label="Merged Into (barcode) *" @bind-Value="_mergedInto" Required="true" Class="mt-2" />
        }
        @if (_reason == "Other")
        {
            <MudTextField T="string" Label="Reason *" @bind-Value="_otherText" Required="true" Lines="2" Class="mt-2" />
        }
        @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
        @if (_busy) { <MudProgressLinear Indeterminate="true" Class="mt-3" /> }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Submit" Disabled="_busy">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Deleting…</span>
            }
            else
            {
                <span>Delete</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>


