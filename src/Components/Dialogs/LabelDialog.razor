<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(Items.Count <= 1 ? "Inventory Label" : $"Inventory Labels ({Items.Count})")</MudText></TitleContent>
    <DialogContent>
        <DialogHotkeys OnSave="Print" OnCancel="() => MudDialog.Close()" />
        @foreach (var item in Items)
        {
            <div class="label-sheet mb-3">
                <div style="font-size:18px;font-weight:bold">@item.Title</div>
                <div>@item.Line2</div>
                <div class="mt-2" style="max-width:320px">@((MarkupString)LabelPdfService.BarcodeSvg(item.Barcode))</div>
                <div style="font-size:11px;letter-spacing:2px">@item.Barcode</div>
                <div style="font-size:11px;margin-top:8px">Printed @DateTime.Now.ToString("yyyy-MM-dd HH:mm") by @App.CurrentDisplayName</div>
            </div>
        }
        <MudText Typo="Typo.caption" Class="mt-2">Label format mirrors the ASRS inventory label style. One label per selected row. Barcodes are real Code 128 symbols (ZXing); the PDF download renders them as vector graphics via PDFsharp.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Close()">Close</MudButton>
        <MudButton OnClick="DownloadPdf" StartIcon="@Icons.Material.Filled.PictureAsPdf">PDF</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print"
                   OnClick="Print">Print</MudButton>
    </DialogActions>
</MudDialog>


