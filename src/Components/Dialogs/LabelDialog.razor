@inject IJSRuntime JS
@inject AppState App

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(Items.Count <= 1 ? "Inventory Label" : $"Inventory Labels ({Items.Count})")</MudText></TitleContent>
    <DialogContent>
        <DialogHotkeys OnSave="Print" OnCancel="() => MudDialog.Close()" />
        @foreach (var item in Items)
        {
            <div class="label-sheet mb-3">
                <div style="font-size:18px;font-weight:bold">@item.Title</div>
                <div>@item.Line2</div>
                <div style="margin-top:8px">BARCODE: @item.Barcode</div>
                <div style="font-size:20px;letter-spacing:4px">||||| |||| |||||</div>
                <div style="font-size:11px;margin-top:8px">Printed @DateTime.Now.ToString("yyyy-MM-dd HH:mm") by @App.CurrentDisplayName</div>
            </div>
        }
        <MudText Typo="Typo.caption" Class="mt-2">Label format mirrors the ASRS inventory label style. One label per selected row.</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Close()">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Print"
                   OnClick="Print">Print</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    // Preferred: pass Labels. Single-label callers may still pass Title/Line2/Barcode.
    [Parameter] public List<(string Title, string Line2, string Barcode)> Labels { get; set; } = new();
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Line2 { get; set; } = "";
    [Parameter] public string Barcode { get; set; } = "";

    private List<(string Title, string Line2, string Barcode)> Items =>
        Labels.Count > 0 ? Labels : new() { (Title, Line2, Barcode) };

    private async Task Print()
    {
        App.LogItems("Printed label(s)", Items.Select(i => i.Title));
        await PrimJs.TryInvokeVoidAsync(JS, "prim.print");
    }
}
