<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_model.Id == 0 ? "New Location" : $"Edit Location {_model.LocationName}")</MudText>
    </TitleContent>
    <DialogContent>
        <DialogHotkeys OnSave="Save" OnCancel="() => MudDialog.Cancel()" />
        <MudForm @ref="_form" Model="_model">
            <MudGrid>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Location Name *" @bind-Value="_model.LocationName" Required="true"
                                  Immediate="true" TextChanged="Upper" HelperText="Unique per type + parent." />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Location Type *" @bind-Value="_model.LocationType" Required="true">
                        @foreach (var t in SeedData.LocationTypes) { <MudSelectItem Value="t">@t</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="int?" Label="Parent Location" @bind-Value="_model.ParentId" Clearable="true">
                        @foreach (var l in _locs.Where(x => x.Id != _model.Id))
                        {
                            <MudSelectItem T="int?" Value="@((int?)l.Id)">@l.LocationName (@l.LocationType)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Description" @bind-Value="_model.Description" Lines="2" HelperText="Initial case." />
                </MudItem>
                <MudItem xs="12" md="6">
                    <LabelPicker @bind-Selected="_labels" Actor="@App.CurrentUserId" />
                </MudItem>
            </MudGrid>
            @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>


