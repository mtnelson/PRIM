<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Move @Count item(s)</MudText></TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">Change Home and/or Assignee for the selected @(Kind.ToLower())s.</MudText>
        <MudCheckBox T="bool" Label="Change Home" @bind-Value="_changeHome" />
        @if (_changeHome)
        {
            <MudTextField T="string" Label="New Home" Value="_newHome" ReadOnly="true"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="PickHome" />
            <MudText Typo="Typo.caption">@_newHomeKind</MudText>
            <MudCheckBox T="bool" Label="Default the assignee to the home" @bind-Value="_assigneeFollowsHome" Class="mt-2" />
        }
        <MudCheckBox T="bool" Label="Change Assignee" @bind-Value="_changeAssignee" Class="mt-2" />
        @if (_changeAssignee)
        {
            <MudTextField T="string" Label="New Assignee" Value="_newAssignee" ReadOnly="true"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="PickAssignee" />
            <MudText Typo="Typo.caption">@_newAssigneeKind</MudText>
        }
        @if (_busy) { <MudProgressLinear Indeterminate="true" Class="mt-3" /> }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save"
                   Disabled="_busy || !((_changeHome && _newHome != null) || (_changeAssignee && _newAssignee != null))">
            @if (_busy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Moving…</span>
            }
            else
            {
                <span>Move</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>


@* Pickers are shared: Home and Assignee may both be containers, locations, or users (never compressed records). *@
<DialogHotkeys OnSave="Save" OnCancel="() => MudDialog.Cancel()" />
