<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(_model.Id == 0 ? "New Record" : $"Edit Record {_model.RecordNumber}")</MudText>
    </TitleContent>
    <DialogContent>
        <DialogHotkeys OnSave="Save" OnCancel="Cancel" />
        <MudForm @ref="_form" Model="_model">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Record Type *" @bind-Value="_model.RecordType" Required="true"
                               Disabled="_typeLocked" HelperText="@(_typeLocked ? "Type changes require the Records Manager role." : "")">
                        @foreach (var t in SeedData.RecordTypes) { <MudSelectItem Value="t">@t</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                @if (_model.RecordType == "Compressed")
                {
                    <MudItem xs="12" md="6" Class="d-flex align-center">
                        <MudRadioGroup T="string" @bind-Value="_model.CompressedRole">
                            <MudRadio Value="@("Parent")">Parent</MudRadio>
                            <MudRadio Value="@("Child")">Child</MudRadio>
                        </MudRadioGroup>
                        <MudText Typo="Typo.caption" Class="ml-2">Required: a Parent holds other records; a Child is filed under a Parent.</MudText>
                    </MudItem>
                }
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="State" @bind-Value="_model.State">
                        @foreach (var s in SeedData.RecordStates) { <MudSelectItem Value="s">@s</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Case Classification *" @bind-Value="_model.CaseClassification"
                                  Required="true" Immediate="true" TextChanged="UpperClass" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" Label="Field Office *" @bind-Value="_model.FieldOffice" Required="true">
                        @foreach (var fo in SeedData.FieldOffices) { <MudSelectItem Value="@fo.Code">@($"{fo.Code} - {fo.Name}")</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Case Number *" @bind-Value="_model.CaseNumber"
                                  Required="true" Immediate="true" TextChanged="UpperCase" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Subfile ID" @bind-Value="_model.SubfileId" Immediate="true" TextChanged="UpperSubfile" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string" Label="Volume *" @bind-Value="_model.Volume" Required="true" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudTextField T="string" Label="Serial Start" @bind-Value="_model.SerialStart" Immediate="true" TextChanged="UpperSerialStart" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudTextField T="string" Label="Serial End" @bind-Value="_model.SerialEnd" Immediate="true" TextChanged="UpperSerialEnd" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Auxiliary Office" @bind-Value="_model.AuxiliaryOffice" Clearable="true">
                        @foreach (var fo in SeedData.FieldOffices) { <MudSelectItem Value="@fo.Code">@($"{fo.Code} - {fo.Name}")</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6" Class="d-flex align-center gap-4">
                    <MudCheckBox T="bool" Label="Is Bulky?" @bind-Value="_model.IsBulky" />
                    <MudCheckBox T="bool" Label="Is Admin?" @bind-Value="_model.IsAdmin" />
                    <MudCheckBox T="bool" Label="Is Control File?" @bind-Value="_model.IsControlFile" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <LabelPicker @bind-Selected="_labels" Actor="@App.CurrentUserId" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Security Classification" @bind-Value="_model.SecurityClassification" Clearable="true">
                        @foreach (var s in SeedData.SecurityClassifications) { <MudSelectItem Value="s">@s</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Notes" @bind-Value="_model.Notes" Lines="3" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Subject" @bind-Value="_model.Subject" Lines="2" />
                </MudItem>
                @if (_model.ParentRecordId != null || (_model.RecordType == "Compressed" && _model.CompressedRole == "Child"))
                {
                    @* Filed under a compressed parent: Home and Assignee ARE the parent record itself. *@
                    <MudItem xs="12" md="6">
                        <MudSelect T="int?" Label="Compressed Parent *" @bind-Value="_model.ParentRecordId"
                                   Required="true" RequiredError="Select the compressed parent." Clearable="true"
                                   HelperText="Home and Assignee are the parent record itself — the child moves with its parent automatically. Clear to un-file.">
                            @foreach (var p in _compressedParents) { <MudSelectItem Value="@((int?)p.Id)">@p.RecordNumber (@p.Barcode)</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="Home *" @bind-Value="_model.Home" Required="true" ReadOnly="true"
                                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" OnAdornmentClick="PickHome" />
                        <MudText Typo="Typo.caption">@_model.HomeKind</MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <div class="d-flex gap-2 align-center">
                            <MudTextField T="string" Label="Assignee *" Value="_model.Assignee" Required="true" ReadOnly="true"
                                          Style="flex:1" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                                          OnAdornmentClick="PickAssignee" />
                            <MudTooltip Text="Default assignee to home">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="MatchHome">Match Home</MudButton>
                            </MudTooltip>
                        </div>
                        <MudText Typo="Typo.caption">@_model.AssigneeKind</MudText>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudSelect T="int?" Label="Parent Record (compressed children)" @bind-Value="_model.ParentRecordId"
                                   Clearable="true" HelperText="File this record under a compressed parent — any record type keeps its type.">
                            @foreach (var p in _compressedParents) { <MudSelectItem Value="@((int?)p.Id)">@p.RecordNumber</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                }
            </MudGrid>
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>


