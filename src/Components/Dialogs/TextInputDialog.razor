@* Generic single-value text input dialog. *@
<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Title</MudText></TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_value" Label="@Label" Immediate="true"
                      OnKeyDown="Key" Margin="Margin.Dense" />
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Ok">OK</MudButton>
    </DialogActions>
</MudDialog>


