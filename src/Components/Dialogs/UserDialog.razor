@inject PrimService Prim
@inject AppState App
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(_model.Id == 0 ? "New User" : $"Edit User {_model.UserId}")</MudText></TitleContent>
    <DialogContent>
        <MudForm @ref="_form" Model="_model">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="User ID *" @bind-Value="_model.UserId" Required="true" Disabled="_model.Id != 0" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Display Name *" @bind-Value="_model.DisplayName" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Role *" @bind-Value="_model.Role" Required="true">
                        @foreach (var r in SeedData.Roles) { <MudSelectItem Value="r">@r</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Email" @bind-Value="_model.Email" InputType="InputType.Email" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox T="bool" Label="Active" @bind-Value="_model.Active" />
                </MudItem>
            </MudGrid>
            @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public AppUser Model { get; set; } = new();

    private MudForm _form = null!;
    private AppUser _model = new();
    private string? _error;

    protected override void OnInitialized()
    {
        _model = Model.Id == 0 ? new AppUser() : new AppUser
        {
            Id = Model.Id, UserId = Model.UserId, DisplayName = Model.DisplayName,
            Role = Model.Role, Email = Model.Email, Active = Model.Active, RowVersion = Model.RowVersion
        };
    }

    private async Task Save()
    {
        _error = null;
        await _form.Validate();
        if (!_form.IsValid) return;
        var isNew = _model.Id == 0;
        var (ok, err) = await Prim.SaveUserAsync(_model, App.CurrentUserId);
        if (!ok) { _error = err; return; }
        Snackbar.Add(isNew ? "User created." : "User updated.", Severity.Success);
        App.Log(isNew ? "Created user" : "Updated user", _model.UserId);
        MudDialog.Close(DialogResult.Ok(true));
    }
}
