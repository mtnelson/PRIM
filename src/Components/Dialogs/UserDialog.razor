<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(_model.Id == 0 ? "New User" : $"Edit User {_model.UserId}")</MudText></TitleContent>
    <DialogContent>
        <DialogHotkeys OnSave="Save" OnCancel="() => MudDialog.Cancel()" />
        <MudForm @ref="_form" Model="_model">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="User ID *" @bind-Value="_model.UserId" Required="true" Disabled="_model.Id != 0" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Display Name *" @bind-Value="_model.DisplayName" Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="string" Label="Role *" @bind-Value="_model.Role" Required="true">
                        @foreach (var r in SeedData.Roles) { <MudSelectItem Value="r">@r</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="Email" @bind-Value="_model.Email" InputType="InputType.Email" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudSelect T="int?" Label="Location membership" @bind-Value="_model.LocationId" Clearable="true"
                               HelperText="Optional location this user belongs to.">
                        @foreach (var l in _locations) { <MudSelectItem Value="@((int?)l.Id)">@l.LocationName (@l.LocationType)</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" Label="New password" @bind-Value="_password" InputType="InputType.Password"
                                  HelperText="Dev only — production uses OAuth/SSO. Leave blank to keep the current password." />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox T="bool" Label="Active" @bind-Value="_model.Active" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <LabelPicker @bind-Selected="_labels" Actor="@App.CurrentUserId" />
                </MudItem>
            </MudGrid>
            @if (!string.IsNullOrEmpty(_error)) { <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert> }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>


