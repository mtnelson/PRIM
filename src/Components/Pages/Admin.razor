@page "/admin"
<PageTitle>PRIM — Admin</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Administration</MudText>

<MudTabs Rounded="true">
    <MudTabPanel Text="Deleted Records">
        <div class="d-flex align-center mt-2 mb-2">
            <MudText Typo="Typo.subtitle1"><b>Deleted record review</b></MudText>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Load">Refresh</MudButton>
        </div>
        <MudDataGrid Items="_deletedRows" Dense="true" Hover="true" HorizontalScrollbar="true" Class="prim-grid">
            <Columns>
                @foreach (var col in _deletedCols)
                {
                    var c = col;
                    <TemplateColumn T="DeletedRow" Title="@c.Label"
                                        HeaderStyle="@GridColumns.ColMinWidth(c.Key)" CellStyle="@GridColumns.ColMinWidth(c.Key)">
                        <CellTemplate>@context.Item.Cells.GetValueOrDefault(c.Key, "")</CellTemplate>
                    </TemplateColumn>
                }
                <TemplateColumn T="DeletedRow" Title="" HeaderStyle="min-width:110px;" CellStyle="min-width:110px;">
                    <CellTemplate>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Success"
                                   OnClick="() => Restore(context.Item.Item)">Restore</MudButton>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
        </MudDataGrid>
        @if (!_deleted.Any())
        {
            <MudText Typo="Typo.body2" Class="pa-4" Style="opacity:0.6">No deleted records.</MudText>
        }
    </MudTabPanel>

    <MudTabPanel Text="Announcement">
        <MudPaper Elevation="1" Class="pa-4 mt-2" Style="max-width:640px">
            <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Global announcement banner</b></MudText>
            <MudTextField T="string" @bind-Value="_announcement" Lines="3" Label="Announcement text (empty clears it)" />
            <div class="d-flex gap-2 mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAnnouncement">Save</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="ClearAnnouncement">Clear</MudButton>
            </div>
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Saved Searches">
        <MudTable Items="_searches" Dense="true" Hover="true" Class="mt-2">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Owner</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Name">@context.Name</MudTd>
                <MudTd DataLabel="Type">@context.ObjectKind</MudTd>
                <MudTd DataLabel="Owner">@context.OwnerUserId</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => DeleteSearch(context)" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudTabPanel>
    <MudTabPanel Text="Test Data">
        <MudPaper Elevation="1" Class="pa-4 mt-2" Style="max-width:640px">
            <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Generate test records</b></MudText>
            <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:0.7">
                Inserts 1,500 realistic records (all fields filled; some compressed parents with
                children for testing expandable rows). Record/barcode numbering continues from the
                current maximum. Subjects are prefixed <b>[TEST]</b> so they are easy to find and delete.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Warning" Disabled="_seeding"
                       OnClick="SeedTestData">
                @if (_seeding)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @(_seeding ? "Generating…" : "Generate 1,500 Test Records")
            </MudButton>
        </MudPaper>
    </MudTabPanel>
    <MudTabPanel Text="Audit Retention">
        <MudPaper Elevation="1" Class="pa-4 mt-2" Style="max-width:960px">
            <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Audit log retention</b></MudText>
            <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:0.7">
                Count-based, three tiers. The hot audit table is capped at @_auditStats.MaxHotRows rows —
                overflow moves oldest-first into the archive table. The archive table is capped at
                @_auditStats.MaxArchiveRows rows — overflow is exported to a checksummed file, verified,
                then removed. Rows are never deleted without a verified copy elsewhere. Archived rows stay
                visible in every item's audit log, including rows already exported to files.
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-1">
                Hot rows: <b>@_auditStats.HotRows.ToString("N0")</b>
                · Archived rows: <b>@_auditStats.ArchivedRows.ToString("N0")</b>
                · Export files: <b>@_auditStats.ExportFiles</b>
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-3" Style="opacity:0.7">Export folder: @_auditStats.ArchiveDirectory</MudText>
            <div class="d-flex gap-2 mb-3">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="RetentionBusy" OnClick="ArchiveNow">@(_retentionOp == "archive" ? "Archiving…" : "Archive now")</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="RetentionBusy" OnClick="ExportNow">@(_retentionOp == "export" ? "Exporting…" : "Export archive to file")</MudButton>
                @if (RetentionBusy)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ml-2" />
                }
            </div>
            @if (_exportFiles.Any())
            {
                <MudTable Items="_exportFiles" Dense="true" Hover="true">
                    <HeaderContent>
                        <MudTh>File</MudTh><MudTh>Rows</MudTh><MudTh>Size</MudTh>
                        <MudTh>Created (UTC)</MudTh><MudTh>SHA-256</MudTh><MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="File">@context.FileName</MudTd>
                        <MudTd DataLabel="Rows">@context.Rows.ToString("N0")</MudTd>
                        <MudTd DataLabel="Size">@FormatBytes(context.Bytes)</MudTd>
                        <MudTd DataLabel="Created">@context.CreatedUtc.ToString("yyyy-MM-dd HH:mm")</MudTd>
                        <MudTd DataLabel="SHA-256"><span style="font-family:monospace">@(context.Sha256.Length > 16 ? context.Sha256[..16] + "…" : context.Sha256)</span></MudTd>
                        <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => ViewExport(context)">View</MudButton></MudTd>
                    </RowTemplate>
                </MudTable>
            }
            else
            {
                <MudText Typo="Typo.body2" Style="opacity:0.6">No export files yet.</MudText>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>


