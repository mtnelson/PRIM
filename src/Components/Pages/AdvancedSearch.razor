@page "/advanced"
@inject PrimService Prim
@inject AppState App
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject HotkeyManager Hotkeys
@implements IDisposable

<PageTitle>PRIM — Advanced Search</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Advanced Search — Records</MudText>

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <div class="d-flex align-center gap-3 mb-2">
        <MudText Typo="Typo.body2">Match</MudText>
        <MudRadioGroup T="string" @bind-Value="_logic" Class="d-flex gap-4">
            <MudRadio Value="@("AND")">ALL criteria (AND)</MudRadio>
            <MudRadio Value="@("OR")">ANY criteria (OR)</MudRadio>
        </MudRadioGroup>
    </div>

    @foreach (var row in _rows)
    {
        var r = row;
        <div class="d-flex gap-2 align-center mb-2">
            <MudSelect T="string" @bind-Value="r.Field" Label="Field" Dense="true" Style="min-width:200px">
                @foreach (var f in _advFields) { <MudSelectItem Value="f.Key">@f.Label</MudSelectItem> }
            </MudSelect>
            <MudSelect T="string" @bind-Value="r.Op" Label="Operator" Dense="true" Style="min-width:150px">
                <MudSelectItem Value="@("Contains")">contains</MudSelectItem>
                <MudSelectItem Value="@("Equals")">equals</MudSelectItem>
                <MudSelectItem Value="@("StartsWith")">starts with</MudSelectItem>
                <MudSelectItem Value="@("EndsWith")">ends with</MudSelectItem>
            </MudSelect>
            <MudTextField T="string" @bind-Value="r.Value" Label="Value (* ? wildcards)" Margin="Margin.Dense" Style="flex:1" />
            <MudIconButton Icon="@Icons.Material.Filled.RemoveCircle" Color="Color.Error" OnClick="() => _rows.Remove(r)" Disabled="_rows.Count == 1" />
        </div>
    }

    <div class="d-flex gap-2 mt-2">
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="() => _rows.Add(new AdvRow())">Add criterion</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" OnClick="RunSearch">Search</MudButton>
    </div>
</MudPaper>

@if (_searched)
{
    <MudText Typo="Typo.subtitle1" Class="mb-2">@_resultsTitle</MudText>
    <RecordGrid @ref="_grid" ItemsProvider="ProvideSearchResults" GridId="advanced" Scope="advanced"
                EditItem="EditRecord" DeleteItems="DeleteRecords"
                OnChanged="RunSearch">
    </RecordGrid>
}

@code {
    private class AdvRow
    {
        public string Field { get; set; } = "CaseNumber";
        public string Op { get; set; } = "Contains";
        public string Value { get; set; } = "";
    }

    protected override void OnInitialized()
    {
        Hotkeys.PushScope("advanced");
        Hotkeys.Register("advanced", "F9", RunSearch);
    }

    public void Dispose() => Hotkeys.UnregisterScope("advanced");

    private List<AdvRow> _rows = new() { new AdvRow() };
    private string _logic = "AND";
    private bool _searched = false;
    private string _resultsTitle = "";
    private List<(string Field, string Op, string Value)> _criteria = new();
    private RecordGrid? _grid;

    // Server-side provider: filtering and paging both happen in the database;
    // the grid fetches 500-row chunks as the user scrolls.
    private Task<GridPageResult<RecordItem>> ProvideSearchResults(GridPageRequest req) =>
        Prim.AdvancedSearchRecordsPageAsync(_criteria, _logic, req);

    private List<(string Key, string Label)> _advFields = new()
    {
        ("RecordNumber","Record Number"), ("RecordType","Record Type"),
        ("CaseClassification","Case Classification"), ("FieldOffice","Field Office"),
        ("CaseNumber","Case Number"), ("SubfileId","Subfile ID"),
        ("Volume","Volume"), ("SerialStart","Serial Start"), ("SerialEnd","Serial End"),
        ("Barcode","Barcode"), ("Home","Home"), ("Assignee","Assignee"),
        ("Subject","Subject"), ("State","State"),
    };

    private async Task RunSearch()
    {
        var rows = _rows.Where(r => !string.IsNullOrWhiteSpace(r.Value)).ToList();
        if (rows.Count == 0) { Snackbar.Add("Enter at least one criterion.", Severity.Info); return; }

        _criteria = rows.Select(r => (r.Field, r.Op, r.Value)).ToList();
        var count = await Prim.AdvancedSearchRecordsCountAsync(_criteria, _logic);
        _resultsTitle = $"{count} record(s) found";
        _searched = true;
        if (_grid != null) await _grid.ResetAsync();
        App.Log("Advanced search", _resultsTitle);
    }

    private async Task<bool> EditRecord(RecordItem r)
    {
        var d = await DialogService.ShowAsync<RecordDialog>("Edit Record",
            new DialogParameters { ["Model"] = r },
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        return (await d.Result) is { Canceled: false };
    }

    private async Task<bool> DeleteRecords(List<int> ids)
    {
        var d = await DialogService.ShowAsync<DeleteDialog>("Delete Records",
            new DialogParameters { ["Ids"] = ids }, new DialogOptions { MaxWidth = MaxWidth.Medium });
        return (await d.Result) is { Canceled: false };
    }
}
