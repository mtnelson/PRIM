@page "/containers"
<PageTitle>PRIM — Containers</PageTitle>

<div class="d-flex align-center mb-3">
    <MudText Typo="Typo.h5">Containers</MudText>
    <MudSpacer />
    <div id="containers-filter">
        <MudTextField T="string" Value="_filter" ValueChanged="OnFilterChanged" DebounceInterval="400"
                      Placeholder="Filter…  (Ctrl+F)" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:260px" Class="mr-2" />
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewContainer">New Container (Ctrl+N)</MudButton>
</div>

<SearchTabs Tabs="_tabs" ActiveId="_activeTab?.Id ?? 0"
            OnActivate="ActivateTab" OnClose="CloseTab" OnAdd="NewTab" />

<ContainerGrid @ref="_grid" ItemsProvider="ProvideContainers" GridId="containers" Scope="containers"
            CountProvider="() => Prim.CountContainersAsync(_filter)" AllIdsProvider="() => Prim.GetAllContainerIdsAsync(_filter)"
               EditItem="EditContainer" DeleteItems="DeleteContainers"
               OnChanged="OnGridChanged" TabState="_tabState" TabStateChanged="OnTabStateChanged">
</ContainerGrid>


