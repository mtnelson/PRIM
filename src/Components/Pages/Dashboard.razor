@page "/"
<PageTitle>PRIM — Dashboard</PageTitle>

<MudText Typo="Typo.h5" Class="mb-3">Quick Search</MudText>
@if (_searching)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}

<MudPaper Elevation="1" Class="pa-4 mb-4">
    <MudRadioGroup T="string" Value="_objectType" ValueChanged="OnObjectTypeChanged" Class="mb-2">
        <MudRadio Value="@("Record")">Records</MudRadio>
        <MudRadio Value="@("Container")">Containers</MudRadio>
        <MudRadio Value="@("Location")">Locations</MudRadio>
    </MudRadioGroup>

    <MudGrid>
        @foreach (var f in _fields)
        {
            var field = f;
            <MudItem xs="12" md="4" Class="d-flex align-center gap-2">
                <MudCheckBox T="bool" Value="_selectedFields.Contains(field.Key)"
                             ValueChanged="v => ToggleField(field.Key, v)" Dense="true" Style="min-width:170px">
                    @field.Label
                </MudCheckBox>
                @if (_selectedFields.Contains(field.Key))
                {
                    <MudTextField T="string" @bind-Value="_criteria[field.Key]" Placeholder="* wildcard supported"
                                  Margin="Margin.Dense" Immediate="true" OnKeyDown="OnKeyDown" Style="flex:1" />
                }
            </MudItem>
        }
    </MudGrid>

    <div class="d-flex gap-2 mt-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Search" Disabled="_searching" OnClick="RunSearch">@(_searching ? "Searching…" : "Search")</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="ClearCriteria">Clear</MudButton>
        <MudSpacer />
        <MudTextField T="string" @bind-Value="_saveName" Placeholder="Save search as…" Margin="Margin.Dense" Style="max-width:220px" />
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveSearch" Disabled="string.IsNullOrWhiteSpace(_saveName)">Save</MudButton>
    </div>

    @if (_saved.Count > 0)
    {
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-1">Saved searches</MudText>
        <MudChipSet T="string">
            @foreach (var s in _saved)
            {
                <MudChip T="string" OnClick="() => LoadSaved(s)" OnClose="() => DeleteSaved(s)">@s.Name</MudChip>
            }
        </MudChipSet>
    }
</MudPaper>

@if (_searched)
{
    <MudText Typo="Typo.subtitle1" Class="mb-2">@_resultsTitle</MudText>

    @if (_objectType == "Record")
    {
        <RecordGrid @ref="_recordGrid" Items="_records" GridId="dashboard-records" Scope="dashboard"
                    EditItem="EditRecord" DeleteItems="DeleteRecords"
                    OnChanged="RunSearch">
        </RecordGrid>
    }
    else if (_objectType == "Container")
    {
        <ContainerGrid @ref="_containerGrid" Items="_containers" GridId="dashboard-containers" Scope="dashboard"
                       EditItem="EditContainer" DeleteItems="DeleteContainers"
                       OnChanged="RunSearch">
        </ContainerGrid>
    }
    else
    {
        <LocationGrid @ref="_locationGrid" Items="_locations" GridId="dashboard-locations" Scope="dashboard"
                      EditItem="EditLocation"
                      CanMove="false" CanDelete="false"
                      OnChanged="RunSearch">
        </LocationGrid>
    }
}


