@page "/records"
<PageTitle>RIM — Records</PageTitle>

<div class="d-flex align-center mb-3">
    <MudText Typo="Typo.h5">Records</MudText>
    <MudSpacer />
    <div id="records-filter">
        <MudTextField T="string" Value="_filter" ValueChanged="OnFilterChanged" DebounceInterval="400"
                      Placeholder="Filter…  (Ctrl+F)" Margin="Margin.Dense"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Style="max-width:260px" Class="mr-2" />
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewRecord">New Record</MudButton>
</div>

<SearchTabs Tabs="_tabs" ActiveId="_activeTab?.Id ?? 0"
            OnActivate="ActivateTab" OnClose="CloseTab" OnAdd="NewTab" />

<RecordGrid @ref="_grid" ItemsProvider="ProvideRecords" GridId="records" Scope="records"
            CountProvider="() => Rim.CountRecordsAsync(_filter)" AllIdsProvider="() => Rim.GetAllRecordIdsAsync(_filter)"
            EditItem="EditRecord" DeleteItems="DeleteRecords"
            OnChanged="OnGridChanged" TabState="_tabState" TabStateChanged="OnTabStateChanged">
</RecordGrid>


