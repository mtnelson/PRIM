@page "/users"
@inject PrimService Prim
@inject AppState App
@inject HotkeyManager Hotkeys
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

<PageTitle>PRIM — Users</PageTitle>

<div class="d-flex align-center mb-3">
    <MudText Typo="Typo.h5">Users</MudText>
    <MudSpacer />
    <MudCheckBox T="bool" Value="_showInactive" ValueChanged="OnShowInactiveChanged" Label="Show inactive" Dense="true" Class="mr-2" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewUser">New User (Ctrl+N)</MudButton>
</div>

<MudText Typo="Typo.caption" Class="mb-2" Style="opacity:0.7">
    Users can be members of a location (set on the user dialog) and can be homes or
    assignees of records and containers. Right-click a row for actions. Users are deactivated, not deleted.
</MudText>

<UserGrid @ref="_grid" ItemsProvider="ProvideUsers" GridId="users" Scope="users"
          EditItem="EditUser" OnChanged="OnGridChanged" CanMove="false" />

@code {
    private UserGrid? _grid;
    private bool _showInactive;

    private Task<GridPageResult<AppUser>> ProvideUsers(GridPageRequest req)
        => Prim.GetUsersPageAsync(req, _showInactive);

    private async Task OnShowInactiveChanged(bool v)
    {
        _showInactive = v;
        if (_grid != null) await _grid.ResetAsync();
    }

    protected override void OnInitialized()
    {
        Hotkeys.PushScope("users");
        Hotkeys.Register("users", "Ctrl+N", NewUser);
        Hotkeys.Register("users", "F9", Refresh);
    }

    public void Dispose() => Hotkeys.UnregisterScope("users");

    private async Task Refresh() { await OnGridChanged(); Snackbar.Add("Users refreshed.", Severity.Info); }

    private async Task OnGridChanged()
    {
        if (_grid != null) await _grid.ResetAsync();
    }

    private async Task NewUser()
    {
        var d = await DialogService.ShowAsync<UserDialog>("New User",
            new DialogParameters { ["Model"] = new AppUser() },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if ((await d.Result) is { Canceled: false }) await OnGridChanged();
    }

    private async Task<bool> EditUser(AppUser u)
    {
        var d = await DialogService.ShowAsync<UserDialog>("Edit User",
            new DialogParameters { ["Model"] = u },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        return (await d.Result) is { Canceled: false };
    }
}
