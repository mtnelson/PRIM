@page "/users"
<PageTitle>RIM — Users</PageTitle>

<div class="d-flex align-center mb-3">
    <MudText Typo="Typo.h5">Users</MudText>
    <MudSpacer />
    <MudCheckBox T="bool" Value="_showInactive" ValueChanged="OnShowInactiveChanged" Label="Show inactive" Dense="true" Class="mr-2" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewUser">New User</MudButton>
</div>

<MudText Typo="Typo.caption" Class="mb-2" Style="opacity:0.7">
    Users can be members of a location (set on the user dialog) and can be homes or
    assignees of records and containers. Right-click a row for actions. Users are deactivated, not deleted.
</MudText>

<SearchTabs Tabs="_tabs" ActiveId="_activeTab?.Id ?? 0"
            OnActivate="ActivateTab" OnClose="CloseTab" OnAdd="NewTab" />

<UserGrid @ref="_grid" ItemsProvider="ProvideUsers" GridId="users" Scope="users"
          CountProvider="() => Rim.CountUsersAsync(_showInactive)" AllIdsProvider="() => Rim.GetAllUserIdsAsync(_showInactive)"
          EditItem="EditUser" OnChanged="OnGridChanged" CanMove="false" TabState="_tabState" TabStateChanged="OnTabStateChanged" />


