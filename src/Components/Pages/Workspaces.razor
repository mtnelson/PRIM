@page "/workspaces"
@inject PrimService Prim
@inject AppState App
@inject HotkeyManager Hotkeys
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>PRIM — Workspaces</PageTitle>
<MudText Typo="Typo.h5" Class="mb-3">Workspaces</MudText>
<MudText Typo="Typo.body2" Class="mb-4" Style="opacity:0.7">
    Five personal workspaces plus Favorites (TIS-1411). Items are stored per user.
    Each section below is the same full data grid as its main screen — expand rows,
    click Home/Assignee or Path breadcrumbs to navigate. Right-click a row for actions —
    removing an item from a workspace never deletes the item itself.
</MudText>

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2" @bind-ActivePanelIndex="_tab">
    @foreach (var slot in Slots)
    {
        var s = slot;
        <MudTabPanel Text="@s">
            @{
                var g = _groups.GetValueOrDefault(s, Empty);
                Func<List<int>, Task> rmRec = ids => RemoveSelected(s, "Record", ids);
                Func<List<int>, Task> rmCont = ids => RemoveSelected(s, "Container", ids);
                Func<List<int>, Task> rmLoc = ids => RemoveSelected(s, "Location", ids);
                Func<List<int>, Task> rmUser = ids => RemoveSelected(s, "User", ids);
            }
            @if (g.IsEmpty)
            {
                <MudText Typo="Typo.caption" Class="pa-4" Style="opacity:0.7">
                    Empty. Right-click items on other screens and choose Add to Workspace.
                </MudText>
            }
            else
            {
                @if (g.Records.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Records (@g.Records.Count)</MudText>
                    <RecordGrid Items="g.Records" GridId="@GridIdFor(s, "record")" Scope="workspaces"
                                CanMove="false" CanDelete="false" ShowRemoveFromSlot="true"
                                RemoveFromSlot="rmRec"
                                OnChanged="Load" />
                }
                @if (g.Containers.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Containers (@g.Containers.Count)</MudText>
                    <ContainerGrid Items="g.Containers" GridId="@GridIdFor(s, "container")" Scope="workspaces"
                                   CanMove="false" CanDelete="false" ShowRemoveFromSlot="true"
                                   RemoveFromSlot="rmCont"
                                   OnChanged="Load" />
                }
                @if (g.Locations.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Locations (@g.Locations.Count)</MudText>
                    <LocationGrid Items="g.Locations" GridId="@GridIdFor(s, "location")" Scope="workspaces"
                                  CanMove="false" CanDelete="false" ShowRemoveFromSlot="true"
                                  RemoveFromSlot="rmLoc"
                                  OnChanged="Load" />
                }
                @if (g.Users.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Users (@g.Users.Count)</MudText>
                    <UserGrid Items="g.Users" GridId="@GridIdFor(s, "user")" Scope="workspaces"
                              CanMove="false" CanDelete="false" ShowRemoveFromSlot="true"
                              RemoveFromSlot="rmUser"
                              OnChanged="Load" />
                }
            }
        </MudTabPanel>
    }
</MudTabs>

@code {
    private static readonly string[] Slots =
        { "Workspace 1", "Workspace 2", "Workspace 3", "Workspace 4", "Workspace 5", "Favorites" };

    private record SlotGroups(List<RecordItem> Records, List<Container> Containers,
        List<Location> Locations, List<AppUser> Users)
    {
        public bool IsEmpty => Records.Count == 0 && Containers.Count == 0
            && Locations.Count == 0 && Users.Count == 0;
    }

    private static readonly SlotGroups Empty = new(new(), new(), new(), new());
    private Dictionary<string, SlotGroups> _groups = new();
    private int _tab;

    private static string GridIdFor(string slot, string kind) =>
        "ws-" + slot.ToLowerInvariant().Replace(" ", "-") + "-" + kind;

    protected override async Task OnInitializedAsync()
    {
        Hotkeys.PushScope("workspaces");
        Hotkeys.Register("workspaces", "F9", Refresh);
        await Load();
    }

    public void Dispose() => Hotkeys.UnregisterScope("workspaces");

    private async Task Refresh() { await Load(); Snackbar.Add("Workspaces refreshed.", Severity.Info); }

    private async Task Load()
    {
        var next = new Dictionary<string, SlotGroups>();
        foreach (var s in Slots)
        {
            var items = await Prim.GetSlotAsync(App.CurrentUserId, s);
            next[s] = new SlotGroups(
                await Prim.GetRecordsByIdsAsync(items.Where(w => w.ObjectKind == "Record").Select(w => w.ObjectId)),
                await Prim.GetContainersByIdsAsync(items.Where(w => w.ObjectKind == "Container").Select(w => w.ObjectId)),
                await Prim.GetLocationsByIdsAsync(items.Where(w => w.ObjectKind == "Location").Select(w => w.ObjectId)),
                await Prim.GetUsersByIdsAsync(items.Where(w => w.ObjectKind == "User").Select(w => w.ObjectId)));
        }
        _groups = next;
        StateHasChanged();
    }

    // Delete on a workspace grid removes the selected item(s) from the slot,
    // never the underlying object.
    private async Task RemoveSelected(string slot, string kind, List<int> ids)
    {
        foreach (var id in ids)
            await Prim.RemoveFromSlotAsync(App.CurrentUserId, slot, kind, id);
        App.Log("Removed from " + slot, $"{ids.Count} item(s)");
        await Load();
    }
}
