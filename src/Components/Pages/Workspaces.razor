@page "/workspaces"
<PageTitle>RIM — Workspaces</PageTitle>
<MudText Typo="Typo.h5" Class="mb-3">Workspaces</MudText>
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-3" />
}
<MudText Typo="Typo.body2" Class="mb-4" Style="opacity:0.7">
    Five personal workspaces plus Favorites. Items are stored per user.
    Each section below is the same full data grid as its main screen — expand rows,
    click Home/Assignee or Path breadcrumbs to navigate. Right-click a row for actions —
    removing an item from a workspace never deletes the item itself.
</MudText>

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2" @bind-ActivePanelIndex="_tab">
    @foreach (var slot in Slots)
    {
        var s = slot;
        <MudTabPanel Text="@s">
            @{
                var g = _groups.GetValueOrDefault(s, Empty);
                Func<List<int>, Task> rmRec = ids => RemoveSelected(s, "Record", ids);
                Func<List<int>, Task> rmCont = ids => RemoveSelected(s, "Container", ids);
                Func<List<int>, Task> rmLoc = ids => RemoveSelected(s, "Location", ids);
                Func<List<int>, Task> rmUser = ids => RemoveSelected(s, "User", ids);
            }
            @if (g.IsEmpty)
            {
                <MudText Typo="Typo.caption" Class="pa-4" Style="opacity:0.7">
                    Empty. Right-click items on other screens and choose Add to Workspace.
                </MudText>
            }
            else
            {
                @if (g.Records.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Records (@g.Records.Count)</MudText>
                    <RecordGrid Items="g.Records" GridId="@GridIdFor(s, "record")" Scope="workspaces"
                                CanMove="false" CanDelete="false" ShowRemoveFromSlot="true"
                                RemoveFromSlot="rmRec"
                                OnChanged="Load" />
                }
                @if (g.Containers.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Containers (@g.Containers.Count)</MudText>
                    <ContainerGrid Items="g.Containers" GridId="@GridIdFor(s, "container")" Scope="workspaces"
                                   CanMove="false" CanDelete="false" ShowRemoveFromSlot="true"
                                   RemoveFromSlot="rmCont"
                                   OnChanged="Load" />
                }
                @if (g.Locations.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Locations (@g.Locations.Count)</MudText>
                    <LocationGrid Items="g.Locations" GridId="@GridIdFor(s, "location")" Scope="workspaces"
                                  CanMove="false" CanDelete="false" ShowRemoveFromSlot="true"
                                  RemoveFromSlot="rmLoc"
                                  OnChanged="Load" />
                }
                @if (g.Users.Count > 0)
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Users (@g.Users.Count)</MudText>
                    <UserGrid Items="g.Users" GridId="@GridIdFor(s, "user")" Scope="workspaces"
                              CanMove="false" CanDelete="false" ShowRemoveFromSlot="true"
                              RemoveFromSlot="rmUser"
                              OnChanged="Load" />
                }
            }
        </MudTabPanel>
    }
</MudTabs>


