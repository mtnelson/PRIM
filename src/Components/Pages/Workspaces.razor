@page "/workspaces"
@inject PrimService Prim
@inject AppState App
@inject HotkeyManager Hotkeys
@inject ISnackbar Snackbar
@implements IDisposable

<PageTitle>PRIM — Workspaces</PageTitle>
<MudText Typo="Typo.h5" Class="mb-3">Workspaces</MudText>
<MudText Typo="Typo.body2" Class="mb-4" Style="opacity:0.7">
    Five personal workspaces plus Favorites (TIS-1411). Items are stored per user.
    Right-click a row for actions — removing an item from a workspace never deletes the item itself.
</MudText>

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-2" @bind-ActivePanelIndex="_tab">
    @foreach (var slot in Slots)
    {
        var s = slot;
        <MudTabPanel Text="@s">
            @{
                var items = _items.GetValueOrDefault(s, new List<WorkspaceItem>());
            }
            @if (items.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="pa-4" Style="opacity:0.7">
                    Empty. Right-click items on other screens and choose Add to Workspace.
                </MudText>
            }
            else
            {
                <ObjectGrid T="WorkspaceItem" Kind="@s" GridId="@GridIdFor(s)" Scope="workspaces" Items="items"
                            GetInfo="@(w => (w.ObjectKind, w.ObjectId, w.Label))"
                            GetBarcode="@(w => "")"
                            ExportCols="GridColumns.WorkspaceColumns()" RowToDict="GridColumns.WorkspaceRow"
                            CanMove="false" CanDelete="false" ShowRemoveFromSlot="true"
                            RemoveFromSlot="(ids => RemoveSelected(s, ids))"
                            OnChanged="Load" />
            }
        </MudTabPanel>
    }
</MudTabs>

@code {
    private static readonly string[] Slots =
        { "Workspace 1", "Workspace 2", "Workspace 3", "Workspace 4", "Workspace 5", "Favorites" };

    private Dictionary<string, List<WorkspaceItem>> _items = new();
    private int _tab;

    private static string GridIdFor(string slot) => "ws-" + slot.ToLowerInvariant().Replace(" ", "-");

    protected override async Task OnInitializedAsync()
    {
        Hotkeys.PushScope("workspaces");
        Hotkeys.Register("workspaces", "F9", Refresh);
        await Load();
    }

    public void Dispose() => Hotkeys.UnregisterScope("workspaces");

    private async Task Refresh() { await Load(); Snackbar.Add("Workspaces refreshed.", Severity.Info); }

    private async Task Load()
    {
        foreach (var s in Slots)
            _items[s] = await Prim.GetSlotAsync(App.CurrentUserId, s);
        StateHasChanged();
    }

    // Delete on the workspace grid removes the selected item(s) from the slot,
    // never the underlying object.
    private async Task RemoveSelected(string slot, List<int> ids)
    {
        var items = _items.GetValueOrDefault(slot, new List<WorkspaceItem>());
        var byId = items.Where(w => ids.Contains(w.ObjectId)).ToList();
        foreach (var w in byId)
            await Prim.RemoveFromSlotAsync(App.CurrentUserId, slot, w.ObjectKind, w.ObjectId);
        App.Log("Removed from " + slot, $"{byId.Count} item(s)");
        await Load();
    }
}
