@* Child rows rendered under an expanded grid row: the items inside a
   compressed record, container, location, or user's holdings. *@
@if (_loading)
{
    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
}
else if (_kids.Count == 0)
{
    <MudText Typo="Typo.caption" Class="pa-2" Style="opacity:.6">No items inside.</MudText>
}
else
{
    <div class="pa-2 pl-10">
        <MudSimpleTable Dense="true" Hover="true" Style="background:transparent">
            <tbody>
                @foreach (var k in _kids)
                {
                    var kid = k;
                    <tr>
                        <td style="width:30px">
                            <MudIcon Icon="@IconFor(kid.Kind)" Size="Size.Small" Style="opacity:.7" />
                        </td>
                        <td>
                            <MudLink Typo="Typo.body2" OnClick="@(() => OnNavigate.InvokeAsync(kid))">@kid.Label</MudLink>
                            @if (kid.HasChildren)
                            {
                                <MudTooltip Text="Open with contents">
                                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                                   OnClick="@(() => OnNavigate.InvokeAsync(kid))" />
                                </MudTooltip>
                            }
                        </td>
                        <td>
                            <MudText Typo="Typo.caption" Style="opacity:.65">@kid.Detail</MudText>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </div>
}

@code {
    [Parameter] public Func<Task<List<ChildItem>>> LoadAsync { get; set; } = () => Task.FromResult(new List<ChildItem>());
    [Parameter] public EventCallback<ChildItem> OnNavigate { get; set; }

    private List<ChildItem> _kids = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _kids = await LoadAsync();
        _loading = false;
    }

    private static string IconFor(string kind) => kind switch
    {
        "Record" => Icons.Material.Filled.Description,
        "Container" => Icons.Material.Filled.Inventory2,
        "Location" => Icons.Material.Filled.Place,
        "User" => Icons.Material.Filled.Person,
        _ => Icons.Material.Filled.Circle,
    };
}
