@* Standard containers grid: full column set, expandable child rows, clickable
   Home/Assignee, breadcrumb Path column. Used by Containers, Dashboard, and Workspaces. *@
<ObjectGrid @ref="_grid" T="Container" Items="Items" ItemsProvider="_provider" OnReset="ResetSupplemental" Kind="Container" GridId="@GridId" Scope="@Scope"
            GetInfo="@(c => ("Container", c.Id, c.ContainerName))"
            GetBarcode="c => c.Barcode"
            EditItem="EditItem" DeleteItems="DeleteItems"
            ExportCols="GridColumns.ContainerColumns()" RowToDict="RowWithPath"
            GetHomeRef="GetHomeRef" GetAssigneeRef="GetAssigneeRef" GetPath="GetPath"
            GetLabelChips="GetChips"
            CountProvider="CountProvider" AllIdsProvider="AllIdsProvider"
            Expandable="true" HasChildren="HasKids" GetChildrenAsync="GetKids"
            CanMove="@CanMove" CanDelete="@CanDelete"
            ShowRemoveFromSlot="@ShowRemoveFromSlot" RemoveFromSlot="RemoveFromSlot"
            OnChanged="OnChanged" TabState="TabState" TabStateChanged="TabStateChanged" />


