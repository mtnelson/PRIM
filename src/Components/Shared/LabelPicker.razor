@* Label picker: select one or many existing labels, or create a new one inline.
   Used by the record/container/location/user edit dialogs. *@
<MudSelect T="string" Label="Labels" MultiSelection="true" MultiSelectionTextFunc="MultiText"
           SelectedValues="_selected" SelectedValuesChanged="OnSelectedChanged"
           Clearable="true" HelperText="Pick from existing labels, or add a new one below.">
    @foreach (var l in _all)
    {
        <MudSelectItem Value="@l.Name">@l.Name</MudSelectItem>
    }
</MudSelect>
<div class="d-flex gap-2 mt-2">
    <MudTextField T="string" @bind-Value="_newName" Label="New label" Margin="Margin.Dense"
                  OnKeyDown="NewLabelKey" Style="flex:1" />
    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="AddNew"
               Disabled="@string.IsNullOrWhiteSpace(_newName)">Add</MudButton>
</div>


