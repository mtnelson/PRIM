@* Label picker: select one or many existing labels, or create a new one inline.
   Used by the record/container/location/user edit dialogs. *@
@inject PrimService Prim
@inject ISnackbar Snackbar

<MudSelect T="string" Label="Labels" MultiSelection="true" MultiSelectionTextFunc="MultiText"
           SelectedValues="_selected" SelectedValuesChanged="OnSelectedChanged"
           Clearable="true" HelperText="Pick from existing labels, or add a new one below.">
    @foreach (var l in _all)
    {
        <MudSelectItem Value="@l.Name">@l.Name</MudSelectItem>
    }
</MudSelect>
<div class="d-flex gap-2 mt-2">
    <MudTextField T="string" @bind-Value="_newName" Label="New label" Margin="Margin.Dense"
                  OnKeyDown="NewLabelKey" Style="flex:1" />
    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="AddNew"
               Disabled="@string.IsNullOrWhiteSpace(_newName)">Add</MudButton>
</div>

@code {
    [Parameter] public List<string> Selected { get; set; } = new();
    [Parameter] public EventCallback<List<string>> SelectedChanged { get; set; }
    [Parameter] public string Actor { get; set; } = "";

    private List<Label> _all = new();
    private IEnumerable<string> _selected = Enumerable.Empty<string>();
    private string _newName = "";

    protected override async Task OnInitializedAsync()
    {
        _all = await Prim.GetLabelsAsync();
        _selected = Selected.ToList();
    }

    private string MultiText(List<string> names) =>
        names.Count == 0 ? "" : names.Count <= 2 ? string.Join(", ", names) : $"{names.Count} labels";

    private async Task OnSelectedChanged(IEnumerable<string> values)
    {
        _selected = values.ToList();
        await SelectedChanged.InvokeAsync(_selected.ToList());
    }

    private async Task NewLabelKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddNew();
    }

    private async Task AddNew()
    {
        var name = _newName.Trim();
        if (name.Length == 0) return;
        try
        {
            var label = await Prim.GetOrCreateLabelAsync(name, string.IsNullOrEmpty(Actor) ? "unknown" : Actor);
            if (!_all.Any(l => l.Id == label.Id)) _all.Add(label);
            _all = _all.OrderBy(l => l.Name).ToList();
            var cur = _selected.ToList();
            if (!cur.Contains(label.Name, StringComparer.OrdinalIgnoreCase)) cur.Add(label.Name);
            _newName = "";
            await OnSelectedChanged(cur);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
