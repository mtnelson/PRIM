@typeparam T
<div class="d-flex align-center mb-1">
    <MudText Typo="Typo.caption" Style="opacity:0.7">
        @(ItemsProvider != null ? $"{(_totalValid ? _totalItems.ToString("N0") : "…")} total · " : "")
        @(_selected.Count == 0 ? "Click a row to select · Ctrl+click toggles · Shift+click selects a range · double-click edits" : $"{_selected.Count} row(s) selected")
    </MudText>
    <MudSpacer />
    <MudTooltip Text="Customize columns (add, remove, reorder — saved to your profile)">
        <MudIconButton Icon="@Icons.Material.Filled.ViewColumn" Size="Size.Small" OnClick="CustomizeColumns" />
    </MudTooltip>
</div>

<GridContextMenu HeaderText="@_menuHeader" NoTarget="@NoTarget"
                 CanMove="CanMove" CanDelete="CanDelete"
                 OnView="MenuView" OnEdit="MenuEdit" OnMove="MenuMove" OnDelete="MenuDelete" OnAudit="MenuAudit"
                 OnAddToSlot="MenuAddToSlot" OnPrint="MenuPrint"
                 OnExport="MenuExport" OnCopy="MenuCopy" OnSelectAll="SelectAll" OnUnselectAll="UnselectAll"
                 OnRemoveFromSlot="MenuRemoveFromSlot" ShowRemove="ShowRemoveFromSlot">
    <Activator>
        <MudDataGrid @key="_gridKey" @ref="_mudGrid" T="T" Items="_mudItems" ServerData="_serveData" Dense="true" Hover="true" MultiSelection="true" Striped="false"
                     Class="rim-grid"
                     HorizontalScrollbar="true" Virtualize="true" VirtualizeServerData="_virtualizeServerData"
                     Height="@EffectiveHeight" FixedHeader="true" OverscanCount="10"
                     Comparer="Comparer"
                     SelectedItems="_selected" SelectedItemsChanged="@(EventCallback.Factory.Create<HashSet<T>>(this, OnSelChanged))"
                     RowClick="@(EventCallback.Factory.Create<DataGridRowClickEventArgs<T>>(this, OnRowClick))"
                     RowClassFunc="RowClass" @ondblclick="OnGridDblClick">
            <PagerContent />
            @* Shown in place of rows while a virtualized chunk is being
               fetched, in both provider and Items mode. *@
            <RowLoadingContent>
                <tr class="mud-table-row">
                    <td class="mud-table-cell" colspan="1000">
                        <span class="d-inline-flex align-center gap-2 pa-1">
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            <MudText Typo="Typo.caption" Style="opacity:0.65">Loading…</MudText>
                        </span>
                    </td>
                </tr>
            </RowLoadingContent>
            <Columns>
                @if (Expandable)
                {
                    @* Caret column: the button is disabled (and hidden by CSS) on rows
                       without children, so the caret only appears where there is
                       something to expand. *@
                    <HierarchyColumn T="T"
                                     ButtonDisabledFunc="@(x => !(HasChildren?.Invoke(x) ?? false))"
                                     InitiallyExpandedFunc="@(x => _forceExpanded.Contains(GetInfo(x).Id))"
                                     EnableHeaderToggle="false" />
                }
                <SelectColumn T="T" />
                @foreach (var col in _effective)
                {
                    var c = col;
                    <TemplateColumn T="T" Title="@c.Label" Sortable="@IsColSortable(c.Key)" SortBy="@GetSortFunc(c.Key)"
                                    HeaderStyle="@GridColumns.ColMinWidth(c.Key)" CellStyle="@GridColumns.ColMinWidth(c.Key)">
                        <CellTemplate>
                            @{
                                var item = context.Item;
                                var homeTgt = c.Key == "Home" ? GetHomeRef?.Invoke(item) : null;
                                var assigneeTgt = c.Key == "Assignee" ? GetAssigneeRef?.Invoke(item) : null;
                            }
                            @if (c.Key == "Path" && GetPath != null)
                            {
                                var segs = GetPath(item);
                                @for (var i = 0; i < segs.Count; i++)
                                {
                                    var s = segs[i];
                                    if (i > 0)
                                    {
                                        <span class="mx-1" style="opacity:.45">›</span>
                                    }
                                    <MudLink Typo="Typo.body2" OnClick="@(() => NavigateToObject(s.Kind, s.Id, true))">@s.Label</MudLink>
                                }
                            }
                            else if (homeTgt is { } h)
                            {
                                <MudLink Typo="Typo.body2" OnClick="@(() => NavigateToObject(h.Kind, h.Id, true))">@CellVal(item, c.Key)</MudLink>
                            }
                            else if (assigneeTgt is { } a)
                            {
                                <MudLink Typo="Typo.body2" OnClick="@(() => NavigateToObject(a.Kind, a.Id, true))">@CellVal(item, c.Key)</MudLink>
                            }
                            else if (c.Key == "Labels" && GetLabelChips != null)
                            {
                                @* Label chips: clicking one opens the label's
                                   member collection, like Home/Path links. *@
                                @foreach (var chip in GetLabelChips(item))
                                {
                                    var cp = chip;
                                    <MudChip T="string" Size="Size.Small" Class="mr-1 mb-1"
                                             OnClick="@(() => Nav.NavigateTo($"/labels/{cp.Id}"))">@cp.Name</MudChip>
                                }
                            }
                            else
                            {
                                @CellVal(item, c.Key)
                            }
                        </CellTemplate>
                    </TemplateColumn>
                }
            </Columns>
            <ChildRowContent>
                @if (Expandable && GetChildrenAsync != null)
                {
                    <ChildRows LoadAsync="@(() => LoadChildren(context.Item))"
                               OnNavigate="OnChildNavigate" />
                }
            </ChildRowContent>
        </MudDataGrid>
    </Activator>
</GridContextMenu>


