@* Standard users grid: full column set, expandable child rows (records and
   containers assigned/homed to the user). Used by Users and Workspaces. *@
<ObjectGrid @ref="_grid" T="AppUser" Items="Items" ItemsProvider="_provider" OnReset="ResetSupplemental" Kind="User" GridId="@GridId" Scope="@Scope"
            GetInfo="@(u => ("User", u.Id, u.DisplayName))"
            GetBarcode="@(u => "")"
            EditItem="EditItem" DeleteItems="DeleteItems"
            ExportCols="GridColumns.UserColumns()" RowToDict="RowWithLabels"
            Expandable="true" HasChildren="HasKids" GetChildrenAsync="GetKids"
            GetLabelChips="GetChips"
            CountProvider="CountProvider" AllIdsProvider="AllIdsProvider"
            CanMove="@CanMove" CanDelete="@CanDelete"
            ShowRemoveFromSlot="@ShowRemoveFromSlot" RemoveFromSlot="RemoveFromSlot"
            OnChanged="OnChanged" TabState="TabState" TabStateChanged="TabStateChanged" />


