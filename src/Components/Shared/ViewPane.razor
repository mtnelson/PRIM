@if (App.ViewPaneSelection is { } sel)
{
    <MudTabs Rounded="true">
        <MudTabPanel Text="Properties">
            <MudSimpleTable Dense="true" Hover="false" Striped="false">
                <tbody>
                    @foreach (var (k, v) in _props)
                    {
                        <tr>
                            <td style="font-weight:600;white-space:nowrap">@k</td>
                            <td>
                                @if (_links.TryGetValue(k, out var tgt))
                                {
                                    <MudLink Typo="Typo.body2" OnClick="@(() => NavigateTo(tgt.Kind, tgt.Id, true))">@v</MudLink>
                                }
                                else
                                {
                                    @v
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudTabPanel>
        <MudTabPanel Text="Notes">
            @if (string.IsNullOrWhiteSpace(_notes))
            {
                <MudText Typo="Typo.body2" Class="pa-2">No notes.</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="pa-2" Style="white-space:pre-wrap">@_notes</MudText>
            }
        </MudTabPanel>
        <MudTabPanel Text="Audit">
            @if (_audit.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="pa-2">No audit events.</MudText>
            }
            else
            {
                <MudTimeline TimelinePosition="TimelinePosition.Start" TimelineAlign="TimelineAlign.Start">
                    @foreach (var a in _audit)
                    {
                        <MudTimelineItem Size="Size.Small" Color="Color.Info">
                            <MudText Typo="Typo.caption">@a.TimestampUtc.ToLocalTime().ToString("g") — @a.Actor</MudText>
                            <MudText Typo="Typo.body2"><b>@a.Action</b>@(a.FieldName != null ? $" · {a.FieldName}" : "")</MudText>
                            @if (a.OldValue != null || a.NewValue != null)
                            {
                                <MudText Typo="Typo.caption">@a.OldValue → @a.NewValue</MudText>
                            }
                        </MudTimelineItem>
                    }
                </MudTimeline>
            }
        </MudTabPanel>
    </MudTabs>
}


